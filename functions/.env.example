# SMTP Configuration for Cloud Functions Mailer
# Copy this file to '.env' in this directory and populate with real credentials before deployment.

# SMTP Host (e.g. smtp.gmail.com, smtp.sendgrid.net, smtp.mailgun.org, smtp.afrihost.co.za)
SMTP_HOST=""

# SMTP Port (465 is secure SSL, 587 is standard STARTTLS)
SMTP_PORT="465"

# SMTP User (e.g. your full email address, or "apikey" if using SendGrid)
SMTP_USER=""

# SMTP Password (your email password, Google App Password, or SendGrid API key)
SMTP_PASS=""
