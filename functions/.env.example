# SMTP Configuration for Cloud Functions Mailer
# Real values are injected at deploy time via GitHub Actions secrets — do not commit a real .env here.

SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""

# ─── WhatsApp Bot Credentials ────────────────────────────
# WHATSAPP_TOKEN: Your Meta System User permanent access token.
WHATSAPP_TOKEN=""
# PHONE_NUMBER_ID: Numeric ID for your WhatsApp number (Meta Dev Portal -> WhatsApp -> API Setup).
PHONE_NUMBER_ID=""
# WHATSAPP_VERIFY_TOKEN: Passphrase YOU invent; paste into Meta webhook "Verify token".
WHATSAPP_VERIFY_TOKEN="ludo_webhook_secret_x9"
# META_APP_SECRET: Your Meta App's App Secret (signature verification).
META_APP_SECRET=""
# ADMIN_PHONE_NUMBER: Number that receives lead alerts. International, no "+" or spaces.
ADMIN_PHONE_NUMBER="27753211350"
# DEEPSEEK_API_KEY: AI conversation fallback provider.
DEEPSEEK_API_KEY=""
# FIELD_ENCRYPTION_KEY: Secret used to encrypt prospect PII in Firestore.
FIELD_ENCRYPTION_KEY=""