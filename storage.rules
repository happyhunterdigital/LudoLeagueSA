rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User avatars/profiles
    match /users/{userId}/{fileName} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
      allow write: if (isAuthenticated() && request.auth.uid == userId && request.resource.size < 10 * 1024 * 1024) || (isAdmin() && request.resource.size < 10 * 1024 * 1024);
    }

    // Tournament assets
    match /tournaments/{tournamentId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size < 10 * 1024 * 1024;
    }

    // Product images
    match /products/{productId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size < 10 * 1024 * 1024;
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
