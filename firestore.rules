rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Tournaments collection
    match /tournaments/{tournamentId} {
      allow read: if true; // Public can view tournaments
      allow write: if isAdmin(); // Only admins can manage tournaments

      // Tournament registrations subcollection
      match /registrations/{registrationId} {
        allow read: if isAdmin() || isOwner(resource.data.userId);
        allow create: if isAuthenticated();
        allow update, delete: if isAdmin();
      }
    }

    // Event registrations collection (Handles frontend sign-ups and donations)
    match /event_registrations/{registrationId} {
      allow create: if request.resource.data.size() <= 1000 &&
                     request.resource.data.email.matches('^[a-zA-Z0-9._%+-]+@.*$'); // Allow public tournament sign-ups and donation submissions with validation
      allow read: if isAdmin() || (isAuthenticated() && request.auth.token.email == resource.data.email);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Top-level registrations collection (used by sendPlayerRegistrationEmail trigger)
    match /registrations/{registrationId} {
      allow create: if request.resource.data.size() <= 1000 &&
                     request.resource.data.email.matches('^[a-zA-Z0-9._%+-]+@.*$');
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Products/Shop collection
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders collection
    match /orders/{orderId} {
      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Mail collection — writable by authenticated admin clients;
    // Cloud Function admin SDK writes bypass rules automatically.
    match /mail/{mailId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    // WhatsApp bot chat history — managed exclusively by Cloud Functions (admin SDK)
    match /whatsapp_history/{phoneId} {
      allow read, write: if false; // Blocked for all clients; admin SDK bypasses this
    }

    // Leads collection — managed exclusively by Cloud Functions (admin SDK)
    match /leads/{leadId} {
      allow read: if isAdmin();
      allow write: if false; // Blocked for all clients; admin SDK bypasses this
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
